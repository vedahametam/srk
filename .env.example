# Origin of the WordPress install that now runs headless (no trailing slash).
# Leave empty to run the frontend on built-in sample content.
WORDPRESS_URL=https://cms.sriramakrishna.in

# Public origin of this Next.js site (used for canonical URLs and metadata).
NEXT_PUBLIC_SITE_URL=https://sriramakrishna.in

# Extra origins whose absolute links inside WordPress content should be
# rewritten to relative links on this site (comma separated).
WORDPRESS_LINK_ORIGINS=https://sriramakrishna.in,https://www.sriramakrishna.in

# Shared secret for the on-publish revalidation webhook (/api/revalidate).
REVALIDATE_SECRET=change-me

# Seconds before cached WordPress responses are refreshed in the background.
WORDPRESS_REVALIDATE_SECONDS=300
